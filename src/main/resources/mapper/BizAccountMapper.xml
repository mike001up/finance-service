<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ehome.mal.financeservice.mapper.BizAccountMapper">

    <resultMap id="AccountTreeMap" type="com.ehome.mal.financeservice.entity.BizAccount">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="account_code" property="accountCode"/>
        <result column="account_name" property="accountName"/>
        <result column="account_type" property="accountType"/>
        <result column="parent_id" property="parentId"/>
        <result column="level" property="level"/>
        <result column="direction" property="direction"/>
        <result column="initial_debit" property="initialDebit"/>
        <result column="initial_credit" property="initialCredit"/>
        <result column="auxiliary_flag" property="auxiliaryFlag"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="del_flag" property="delFlag"/>
        <result column="parent_name" property="parentName"/>
    </resultMap>

    <select id="selectTreeList" resultMap="AccountTreeMap">
        SELECT 
            a.id,
            a.tenant_id,
            a.account_code,
            a.account_name,
            a.account_type,
            a.parent_id,
            a.level,
            a.direction,
            a.initial_debit,
            a.initial_credit,
            a.auxiliary_flag,
            a.status,
            a.remark,
            a.create_time,
            a.update_time,
            a.create_by,
            a.update_by,
            a.del_flag,
            p.account_name as parent_name
        FROM biz_account a
        LEFT JOIN biz_account p ON a.parent_id = p.id
        WHERE a.tenant_id = #{tenantId}
          AND a.del_flag = 0
        ORDER BY a.account_code
    </select>

</mapper>
